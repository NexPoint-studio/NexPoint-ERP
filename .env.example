# Exemplo exclusivamente local. Copie para .env.local antes de executar.
ERP_APP_NAME=ERP
ERP_COMPANY_NAME=Sua Empresa
ERP_VERSION=1.0.0
ERP_BUILD=local
ERP_ENVIRONMENT=local
ERP_SESSION_SECRET=SUBSTITUA_POR_UM_SEGREDO_LOCAL_ALEATORIO_COM_32_CARACTERES
ERP_SESSION_HOURS=12
ERP_REMEMBER_SESSION_DAYS=30
ERP_REMEMBER_SESSION_ROTATION_DAYS=7
ERP_ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_LOCAL_UNICA
ERP_HOST=127.0.0.1
ERP_PORT=8765
ERP_TENANT_TYPE=CUSTOMER
ERP_QA_MODE=0

# Observabilidade local em SQLite separado. DEBUG deve permanecer 0 fora de QA.
ERP_OBSERVABILITY_RETENTION_DAYS=30
ERP_OBSERVABILITY_MAX_EVENTS=50000
ERP_OBSERVABILITY_MAX_BYTES=52428800
ERP_OBSERVABILITY_DEBUG=0
ERP_ADMIN_LOCK_MAX_ATTEMPTS=5
ERP_ADMIN_LOCK_LOCKOUT_MINUTES=5

# Ponte local e opcional entre o ERP e a Nexa.
NEXA_ERP_BRIDGE_URL=http://127.0.0.1:54421/functions/v1/erp-chat
NEXA_ERP_BRIDGE_SECRET=SUBSTITUA_POR_O_MESMO_SEGREDO_CONFIGURADO_NA_NEXA_LOCAL

# Control Center privado da NexPoint. Use credenciais diferentes das do ERP.
CONTROL_CENTER_HOST=127.0.0.1
CONTROL_CENTER_PORT=8770
CONTROL_CENTER_DATABASE_PATH=data/control_center.sqlite3
CONTROL_CENTER_SESSION_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_LOCAL_ALEATORIO_COM_32_CARACTERES
CONTROL_CENTER_ADMIN_USERNAME=SUBSTITUA_POR_UM_USUARIO_INTERNO_NEXPOINT
CONTROL_CENTER_ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_INTERNA_UNICA_COM_12_CARACTERES
# Altere para 1 somente quando quiser carregar Alfa, Beta e Gama ficticias.
CONTROL_CENTER_SEED_DEMO=0
CONTROL_CENTER_ENVIRONMENT=local
CONTROL_CENTER_QA_MODE=0
